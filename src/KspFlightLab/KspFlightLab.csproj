<Project Sdk="Microsoft.NET.Sdk">

  <!-- KSP Flight Lab: the home of the KSP Wingman stack (agents, the KSC tower, what they know, setup). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>KspFlightLab</AssemblyName>
    <Product>KSP Flight Lab</Product>
    <AssemblyTitle>KSP Flight Lab</AssemblyTitle>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- The icon's sources (icon.svg, make-icons.py) stay out of the exe. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\*.svg;Assets\*.py" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KspFlightLab.Core\KspFlightLab.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KspFlightLab.Tests" />
  </ItemGroup>

</Project>
