<Project Sdk="Microsoft.NET.Sdk">

  <!-- LUNA EVO Flight Lab: the home of the KSP Wingman stack (agents, the KSC tower, what they know, setup). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LunaEvo.FlightLab</AssemblyName>
    <Product>LUNA EVO Flight Lab</Product>
    <AssemblyTitle>LUNA EVO Flight Lab</AssemblyTitle>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LunaEvo.FlightLab.Core\LunaEvo.FlightLab.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LunaEvo.FlightLab.Tests" />
  </ItemGroup>

</Project>
